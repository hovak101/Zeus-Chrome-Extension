{
    "manifest_version": 3,
    "name": "Lav",
    "description": "Scrapes web for cheapest price of viewing item.",
    "version": "1.0",

    "permissions": [
      "activeTab",
      "tabs",
      "storage",
      "scripting"
    ],

    "host_permissions": ["<all_urls>"],

    "action": {
      "default_popup": "index.html"
    },

    "background": {
      "service_worker": "background.js"
    }
  }